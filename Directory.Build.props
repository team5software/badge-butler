<Project>
	<!-- General PropertyGroup -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<AssemblyName>$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>T5S.$(MSBuildProjectName)</RootNamespace>

		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>

		<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
		<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
	</PropertyGroup>

	<!-- Test specific PropertyGroup 
	 - Tests are always executables with the MTP / xunit.v3
	-->
	<PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
		<OutputType>Exe</OutputType>
	</PropertyGroup>

	<!-- General ItemGroup -->
	<ItemGroup>
		<CompilerVisibilityProperty Include="RootNamespace" />
		<CompilerVisibilityProperty Include="ProjectDir" />
	</ItemGroup>

	<!-- Non-Test specific ItemGroup
	 - Internals should be visible to the associated test assembly
	-->
	<ItemGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
		<InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
	</ItemGroup>

	<!-- Test specific ItemGroup
	 - Default test packages including xunit, coverlet, TRX-extension, AwesomeAssertions
	 - Microsoft.Testing.Platform is deliberately not referenced: xunit, coverlet and the TRX
	   extension each declare the minimum version they need, and NuGet picks the highest. A direct
	   reference would win over those and break whichever package needs a newer one.
	-->
	<ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
		<PackageReference Include="AwesomeAssertions" />
		<PackageReference Include="coverlet.MTP" />
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
		<PackageReference Include="xunit.v3" />
	</ItemGroup>
</Project>
