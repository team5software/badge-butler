{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],

  "baseBranchPatterns": ["develop"],
  "useBaseBranchConfig": "merge",

  "semanticCommits": "enabled",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,

  "enabledManagers": ["github-actions", "nuget"]
}
